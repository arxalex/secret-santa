{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secret-santa-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-21",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secret-santa-db",
      "database_id": "${DATABASE_ID}",
      "migrations_dir": "migrations"
    }
  ]
}
